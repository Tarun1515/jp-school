/* Standalone project. It shares no configuration with its siblings — that is
   the point of the split — so strictness is declared here rather than
   inherited, and must be kept in step across the four by review. */
{
  "compileOnSave": false,
  "compilerOptions": {
    /* Types only. At runtime these four specifiers are left external by the
       build (federation.config.mjs) and resolved by the import map to bundles
       served by jp-shared on :4999 — nothing here is compiled into this app.
       The repos sit as siblings on disk, which is what makes ../ work. */
    "paths": {
      "jp-shared/*": ["../jp-shared/src/entries/*"]
    },
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
